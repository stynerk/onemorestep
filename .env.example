# sample is offline and never calls a paid API.
LINER_MODE=sample
# Set live only after API usage is authorized; keep the key on the server.
LINER_API_KEY=
# AI_MODE overrides legacy LINER_MODE when set. sample never calls providers.
AI_MODE=sample
# Independent server-side provider selection; Liner is the hackathon default.
SEARCH_PROVIDER=liner
PLANNER_PROVIDER=liner
PLANNER_MODEL=liner-claude-router
# Optional replacement search: SEARCH_PROVIDER=http-json (see docs/tech/API_PROVIDERS.md).
SEARCH_API_URL=
SEARCH_API_KEY=
# Optional replacement model: PLANNER_PROVIDER=chat-completions.
# Use the full HTTPS Chat Completions endpoint and a model supported by that service.
PLANNER_API_URL=
PLANNER_API_KEY=
